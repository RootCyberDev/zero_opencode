# Enable embed mode in the OpenCode backend
OPENCODE_EMBED=1
OPENCODE_DISABLE_PROJECT_CONFIG=1
OPENCODE_SERVER_CORS=https://openzero.centauro.host

# Centauro Keycloak settings
# These match the structure used in /home/metrofico/GolandProjects/centauro
KEYCLOAK_URL=https://auth.centauro.host
KEYCLOAK_REALM=centauro

# Validate the client that minted the access token.
# Use the azp claim from your frontend token.
OPENCODE_EMBED_AZP=test-api-centauro

# Optional extra validation
# OPENCODE_EMBED_AUDIENCE=account

# Optional global MCP API key used by /opt/openzero/config/opencode.json
# CENTAURO_MCP_API_KEY=eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRHNhZGFzZGFzZG9lIiwiYWRtaW5hc2Rhc2RhcyI6dHJ1ZSwiYXMiOiJhYXNkc2FkIiwiaWF0IjoxNTE2MjM5MDIxMjMxMjMyfQ

# Optional override if you want a custom tenant storage root
# OPENCODE_EMBED_ROOT=/absolute/path/to/opencode-embed-data
